{
  "name": "sobreviventes-da-resenha",
  "version": "0.1.0",
  "description": "Sobreviventes da Resenha",
  "main": "main.js",
  "author": "Resenha",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.resenha.sobreviventes",
    "productName": "Sobreviventes da Resenha",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2"
  }
}